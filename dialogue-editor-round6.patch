+        for (const base of [ComponentIds.ROW_MOVE_UP_BASE, ComponentIds.ROW_MOVE_DOWN_BASE, ComponentIds.ROW_DELETE_BASE]) {
+            services.dialog.queueWidgetEvent(playerId, {
+                action: "set_hidden",
+                uid: packUid(groupId, base + i),
+                hidden,
+            });
+        }
+    }
+}
