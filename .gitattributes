* text=auto

# Windows command files require CRLF when invoked directly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell entry points require LF on every platform.
*.sh text eol=lf

# Images and fonts
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.avif -text
*.ico -text
*.woff -text
