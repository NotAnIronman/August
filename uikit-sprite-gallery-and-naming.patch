+import rawSpriteNames from "./spriteNames.json";
+
+/**
+ * Human-assigned names for individual cache sprites, keyed by the same
+ * "archiveId:frame" reference already shown in the sprite gallery label
+ * (see client/widgets/custom/devUIKitPanels.ts). This file is intentionally
+ * a flat, hand-editable JSON map rather than TypeScript: it's meant to be
+ * rewritten constantly (by hand or via the ::Rename command) without a
+ * recompile, and to stay a trivial, mergeable git diff.
+ *
+ * This is a *discovery* registry, not the semantic asset dictionary. Once a
+ * name here is actually wired into a real UIKit panel, promote it into
+ * CacheUiAssets.ts's CACHE_UI_ASSET_ALIASES instead - that's the curated,
+ * intent-carrying layer UIKit widgets read from. This file only answers
+ * "what is this sprite called", nothing more.
+ */
+export type SpriteNameMap = Readonly<Record<string, string>>;
+
+const SPRITE_NAMES: SpriteNameMap = rawSpriteNames as SpriteNameMap;
+
+/** Canonical "archiveId:frame" key format, matching the gallery's on-screen id. */
+export function spriteRefKey(archiveId: number, frame: number): string {
+    return `${archiveId | 0}:${Math.max(0, frame | 0)}`;
+}
+
+export function getAllSpriteNames(): SpriteNameMap {
+    return SPRITE_NAMES;
+}
+
+/** Returns the assigned common name for a sprite, or undefined if unnamed. */
+export function getSpriteCommonName(archiveId: number, frame: number): string | undefined {
+    return SPRITE_NAMES[spriteRefKey(archiveId, frame)];
+}
+
+/**
+ * Label text for a sprite gallery cell: the common name once assigned,
+ * otherwise the raw "archiveId:frame" reference so it stays referenceable
+ * (and pasteable into ::Rename) whether or not it has been named yet.
+ */
+export function formatSpriteGalleryLabel(archiveId: number, frame: number): string {
+    return getSpriteCommonName(archiveId, frame) ?? spriteRefKey(archiveId, frame);
+}
+
+const SPRITE_REF_PATTERN = /^(\d+):(\d+)$/;
+
+/** Parses a user-typed "archiveId:frame" reference, e.g. from ::Rename. */
+export function parseSpriteRef(input: string): { archiveId: number; frame: number } | undefined {
+    const match = SPRITE_REF_PATTERN.exec(input.trim());
+    if (!match) return undefined;
+    return { archiveId: Number(match[1]) | 0, frame: Number(match[2]) | 0 };
+}
+
+const NAME_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;
+
+/** Same convention as "Minimap.Compass-dial": dot-namespaced, no spaces. */
+export function isValidSpriteCommonName(name: string): boolean {
+    return NAME_PATTERN.test(name) && name.length <= 80;
+}
