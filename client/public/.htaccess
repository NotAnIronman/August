RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

<IfModule mod_headers.c>
    Header append Cross-Origin-Opener-Policy: same-origin
    Header append Cross-Origin-Resource-Policy: same-origin
    # Safari/WebKit blocks Worker() under COEP even with CORP. Only enable COEP
    # (for SharedArrayBuffer) on desktop Chromium-family browsers.
    SetEnvIf User-Agent ".*(Chrome|Chromium|Edg|OPR)/.*" DESKTOP_CHROMIUM_UA
    SetEnvIf User-Agent ".*(CriOS|EdgiOS|FxiOS).*" MOBILE_ALT_BROWSER_UA
    Header append Cross-Origin-Embedder-Policy: require-corp env=DESKTOP_CHROMIUM_UA env=!MOBILE_ALT_BROWSER_UA
</IfModule>
