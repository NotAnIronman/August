{
  "name": "@xrsps/server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@foxglove/wasm-bz2": "^0.3.0",
    "bzip2": "^0.1.1",
    "denque": "^2.1.0",
    "gl-matrix": "^3.4.4",
    "java-random": "^0.4.0",
    "pako": "^2.1.0",
    "adm-zip": "^0.5.17",
    "tsx": "^4.22.4",
    "ws": "^8.21.0"
  },
  "scripts": {
    "start": "yarn ensure-npc-drops && yarn ensure-cache && yarn start:world",
    "start:world": "tsx --env-file-if-exists=.env --env-file-if-exists=../.env src/index.ts",
    "dev": "yarn start",
    "build": "yarn typecheck",
    "typecheck": "yarn typecheck:runtime",
    "typecheck:all": "yarn typecheck:runtime && yarn typecheck:tools && yarn typecheck:tests",
    "typecheck:runtime": "tsc --noEmit -p tsconfig.runtime.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "build-collision": "tsx scripts/build-collision-cache.ts --include-models --force",
    "audit-npc-animations": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/audit-npc-animations.ts",
    "build-npc-aggression": "tsx scripts/build-npc-aggression.ts",
    "build-shops": "tsx scripts/build-shops.ts",
    "sync-missing-cache-items": "tsx scripts/sync-missing-cache-items.ts",
    "sync-equipment-data": "yarn ensure-cache && yarn sync-missing-cache-items && yarn sync-equipment-requirements && yarn import-equipment-reference && yarn audit-equipment-data",
    "sync-equipment-requirements": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/sync-osrs-equipment-requirements.ts",
    "sync-npc-drops": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/sync-osrs-npc-drops.ts",
    "ensure-npc-drops": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/sync-osrs-npc-drops.ts --if-missing",
    "import-equipment-reference": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/import-osrs-equipment-reference.ts",
    "audit-equipment-data": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/audit-equipment-data.ts",
    "sync-wiki-skill-guides": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/sync-wiki-skill-guides.ts",
    "import-wiki-dialogue": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/import-wiki-dialogue.ts",
    "ensure-cache": "tsx scripts/ensure-cache.ts --server",
    "merge-wiki-examine": "tsx scripts/merge-wiki-examine.ts",
    "scrape-loc-examine": "tsx scripts/scrape-loc-examine.ts",
    "diagnose-loc-html": "tsx scripts/diagnose-loc-html.ts",
    "fill-blank-examine": "tsx scripts/fill-blank-examine.ts",
    "test": "node ../scripts/run-typescript-tests.mjs tests --exclude=modern-preservation-cache-ids.test.ts --exclude=trade-inventory-widget.test.ts",
    "test:all": "node ../scripts/run-typescript-tests.mjs tests",
    "test:cache": "node ../scripts/run-typescript-tests.mjs tests --only=modern-preservation-cache-ids.test.ts --only=trade-inventory-widget.test.ts",
    "test:smoke": "tsx tests/authentication.test.ts && tsx tests/friends-chat.test.ts && tsx tests/achievement-diary-persistence.test.ts && tsx tests/dialogue-editor.test.ts && tsx tests/dialogue-system.test.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3"
  }
}
