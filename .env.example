# Client build-time config (CRA inlines REACT_APP_* at build).
# Copy to `.env.local` / `.env.production.local`, or set the same keys in Vercel.
# Do not commit real hostnames.

# OSRS cache base URL (trailing slash optional). Default: /caches/
# REACT_APP_CACHE_BASE_URL=https://game.example.com/caches/

# Default WebSocket endpoint before the player picks a server.
# REACT_APP_DEFAULT_WS_URL=wss://game.example.com

# Defaults shown on the login "server" button.
# REACT_APP_DEFAULT_SERVER_ADDRESS=game.example.com
# REACT_APP_DEFAULT_SERVER_NAME=My Server
# REACT_APP_DEFAULT_SERVER_SECURE=true

# Optional JSON array baked into the client (skips fetching /servers.json).
# REACT_APP_SERVERS_JSON=[{"name":"My Server","address":"game.example.com","secure":true,"maxPlayers":2047}]

# Optional remote server-list URL. Default: same-origin /servers.json
# REACT_APP_SERVER_LIST_URL=/servers.json

# Server runtime config. Keep privileged username lists explicit; there are no
# built-in administrator, moderator, or developer accounts.
ADMIN_USERNAMES=
MODERATOR_USERNAMES=
DEVELOPER_USERNAMES=

# New account registration is enabled unless explicitly set to false.
ALLOW_ACCOUNT_REGISTRATION=true
ALLOW_LEGACY_ACCOUNT_CLAIM=false

# Optional address shown only in the host-only server dashboard at /hosting.
# Use a public IP or DNS name, never a URL (for example: play.example.com).
# The game listener already accepts network connections; router forwarding and
# firewall rules are still required before friends outside your LAN can connect.
# PUBLIC_HOST=play.example.com

FAST_REFRESH=false
