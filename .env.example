# Client build-time config (CRA inlines REACT_APP_* at build).
# Copy to `.env.local` / `.env.production.local`, or set the same keys in Vercel.
# Do not commit real hostnames.

# OSRS cache base URL (trailing slash optional). Default: /caches/
# REACT_APP_CACHE_BASE_URL=https://game.example.com/caches/

# Default WebSocket endpoint before the player picks a server.
# REACT_APP_DEFAULT_WS_URL=wss://game.example.com

# Defaults shown on the login "server" button.
# REACT_APP_DEFAULT_SERVER_ADDRESS=game.example.com
# REACT_APP_DEFAULT_SERVER_NAME=My Server
# REACT_APP_DEFAULT_SERVER_SECURE=true

# Optional JSON array baked into the client (skips fetching /servers.json).
# REACT_APP_SERVERS_JSON=[{"name":"My Server","address":"game.example.com","secure":true,"maxPlayers":2047}]

# Optional remote server-list URL. Default: same-origin /servers.json
# REACT_APP_SERVER_LIST_URL=/servers.json

# Server runtime config. Keep privileged username lists explicit; there are no
# built-in administrator, moderator, or developer accounts.
ADMIN_USERNAMES=
MODERATOR_USERNAMES=
DEVELOPER_USERNAMES=

# New account registration is enabled unless explicitly set to false.
ALLOW_ACCOUNT_REGISTRATION=true
ALLOW_LEGACY_ACCOUNT_CLAIM=false

# Public game endpoint advertised by /servers.json and the host-only dashboard.
# Prefer one complete URL when TLS terminates at a same-host reverse proxy.
# PUBLIC_WS_URL=wss://play.example.com
# Direct-hosting alternative (PUBLIC_PORT defaults to the world listener, or
# 443 when PUBLIC_SECURE=true).
# PUBLIC_HOST=play.example.com
# PUBLIC_PORT=43594
# PUBLIC_SECURE=false

# Honor Forwarded/X-Forwarded-For/X-Real-IP for login limits only when the
# direct connection comes from loopback. Enable this for a same-host proxy;
# leave it false for direct port-forwarding.
TRUST_PROXY=false

# WebSocket resource limits. Defaults are suitable for normal game traffic.
# WS_MAX_PAYLOAD_BYTES=1048576
# WS_COMPRESSION=true
# WS_COMPRESSION_THRESHOLD_BYTES=1024
# WS_INPUT_QUEUE_HIGH_WATER_BYTES=2097152
# WS_OUTBOUND_HIGH_WATER_BYTES=8388608

# Connected-player persistence. The interval is measured in game ticks; when
# unset it is derived from the default two-minute interval. Set ticks to 0 to
# disable regular autosaves. Shutdown always performs a final complete flush.
# PLAYER_AUTOSAVE_TICKS=200
# PLAYER_AUTOSAVE_BATCH_SIZE=16

# Login work limits protect the game tick and bound unauthenticated traffic.
# LOGIN_HASH_CONCURRENCY=4
# WS_PREAUTH_MESSAGES_PER_WINDOW=20
# WS_PREAUTH_WINDOW_MS=5000
# Close sockets that never finish login/handshake so idle connections cannot accumulate.
# WS_PREAUTH_TIMEOUT_MS=30000

# Development/diagnostic switches. Strict script startup defaults to true in
# production and false in development.
DEBUG_PLAYER_PATHFINDING=false
# SCRIPT_STRICT_STARTUP=true
# SCRIPT_HOT_RELOAD=1
# TICK_PROFILE=1

# Runtime logging. Per-action traces are debug-only so normal gameplay does not
# block on console output. LOG_INCLUDE/LOG_EXCLUDE accept comma-separated tags
# such as combat, script, or collection-log.
LOG_LEVEL=info
# LOG_FORMAT=json
# LOG_INCLUDE=
# LOG_EXCLUDE=

# Browser diagnostics are build-time CRA values and belong in
# apps/client/.env.local (or the deployment provider), not the root .env.
# REACT_APP_CLIENT_DEBUG=false
# FAST_REFRESH=false
